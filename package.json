{
  "name": "between-tides",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/make-image-variants.mjs && node scripts/wenkai/run.mjs build",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/make-image-variants.mjs && node scripts/wenkai/run.mjs build && node scripts/wenkai/run.mjs check",
    "build": "next build && node scripts/fix-rsc-paths.mjs && node scripts/build-search.mjs && node scripts/wenkai/run.mjs check-html out",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typegen": "next typegen",
    "pretypecheck": "node scripts/make-image-variants.mjs && node scripts/wenkai/run.mjs build",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run build && node scripts/verify-export.mjs",
    "check": "npm run lint && npm run typecheck",
    "diagrams": "node scripts/diagrams/render.mjs",
    "diagrams:check": "node scripts/diagrams/check.mjs",
    "diagrams:sync": "node scripts/diagrams/sync-dims.mjs",
    "images:check": "node scripts/check-image-dims.mjs",
    "residue:check": "node --experimental-strip-types scripts/check-markdown-residue.mjs",
    "residue:fix": "node --experimental-strip-types scripts/check-markdown-residue.mjs --fix",
    "content:check": "npm run diagrams:check && npm run images:check && npm run residue:check",
    "deploy:cf": "npm run build && node scripts/deploy-cloudflare.mjs",
    "deploy:cf:only": "node scripts/deploy-cloudflare.mjs",
    "preview:cf": "npm run build && npx wrangler dev",
    "deploy:doctor": "node scripts/deploy-cloudflare.mjs --dry-run",
    "search:index": "node scripts/build-search.mjs",
    "images:variants": "node scripts/make-image-variants.mjs",
    "font:subset": "node scripts/wenkai/run.mjs build --force",
    "font:check": "node scripts/wenkai/run.mjs check && node scripts/wenkai/run.mjs check-html out",
    "og": "node scripts/og/render-og.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "lucide-react": "^0.577.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "wrangler": "^4.132.0"
  }
}
