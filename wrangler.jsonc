{
  // 汐间 / BETWEEN TIDES —— Next.js 静态导出 + 访客计数 Worker
  //
  // 页面在构建期烘焙为 out/。Worker 只拦截 /api/visits，把去重后的访客数写入 KV。
  // 其余请求仍由静态资源处理，不经过这段脚本。
  //
  // 部署：  npm run deploy:cf
  // 预览：  npx wrangler dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omiki1-home",
  "compatibility_date": "2026-09-16",
  "main": "worker/index.ts",

  "assets": {
    "directory": "./out",

    // 关键：与 next.config.ts 的 trailingSlash: true 对齐。
    //
    // Next 在导出时把每个路由写成 <route>/index.html，站点内部链接也全部带尾斜杠
    // （/blog/、/projects/mediatlas/ …）。Cloudflare 默认的 "auto-trailing-slash"
    // 会把 /blog/ 308 重定向到 /blog，等于每条站内链接都白吃一次跳转。
    // force-trailing-slash 让 /blog/ 直接命中，/blog 反向跳到 /blog/，缓存键也唯一。
    "html_handling": "force-trailing-slash",

    // 找不到的路径直接返回 404，不使用 SPA 回退。
    // 对本站点很重要：404.html 是精心做的页面，SPA 回退会把它顶掉。
    "not_found_handling": "404-page",

    // 只有访客接口走 Worker；HTML 和静态资源仍由 assets 直出。
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "VISITS",
      "id": "ed5adb00aa554415aaee52d7ef492849"
    }
  ],

  // 访客接口流量很小，不需要 observability 采样。
  "observability": {
    "enabled": false
  },

  // 自定义域绑定：把根域直接指到这个静态 Worker。
  //
  // 前提：omiki.cc 已作为 zone 托管在同一个 Cloudflare 账号下。
  // custom_domain: true 会让 Cloudflare 自动创建所需的 DNS 记录与证书，
  // 不需要手工加 CNAME。
  //
  // 域名只出现在这一处；NEXT_PUBLIC_SITE_URL（.env.production）是另一处，
  // 两者必须一致。换域名时同时改这两处。
  "routes": [
    {
      "pattern": "omiki.cc",
      "custom_domain": true
    }
  ]
}
