# 站点公开地址。构建期读取，写入 canonical / og:url / sitemap.xml / rss.xml / JSON-LD。
#
# config/site.ts 里是 `process.env.NEXT_PUBLIC_SITE_URL || "http://localhost:3000"`，
# 也就是说构建时若没设这个变量，产物里的所有绝对 URL 都会指向 localhost:3000，
# 对 SEO 是硬伤。因此这里提供一份**进版本库**的默认值。
#
# 本文件只包含公开地址，不含任何机密，可以安全提交。
# 本地开发不需要它：`next dev` 用 http://localhost:3000 即可。
# 换域名时改这一行，然后重新构建。
#
# 部署到 Cloudflare Workers Builds 时也可以改用构建变量覆盖同名变量，
# 两边保持一致即可。

NEXT_PUBLIC_SITE_URL=https://omiki.cc
